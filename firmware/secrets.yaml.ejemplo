# Copia esto como `secrets.yaml` dentro de /config/esphome/ y rellena lo tuyo.
# El add-on de ESPHome ya suele traer uno con el WiFi puesto.

wifi_ssid: "NOMBRE_DE_TU_WIFI"
wifi_password: "CONTRASENA_DE_TU_WIFI"

# La genera el add-on al crear el dispositivo. NO reutilices la de nadie:
# es la llave que deja controlar el panel desde la red.
api_key: "GENERA_LA_TUYA_EN_EL_ADD-ON"

# Red de rescate que levanta el panel si no consigue conectarse al WiFi.
ap_password: "INVENTA_UNA_DE_8_CARACTERES_O_MAS"
